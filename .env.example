# Copy this file to .env.local and fill in real values.
# Never commit .env.local.

# ──────────────────────────────────────────────────────────────
# LLM — Anthropic Claude
# Get a key at: https://console.anthropic.com/settings/keys
# Optional: override the default model (claude-sonnet-4-5).
# Other options: claude-opus-4-5, claude-sonnet-4-6, claude-haiku-4-5.
# ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ──────────────────────────────────────────────────────────────
# Database — Supabase Postgres (use the Transaction pooler URL,
# port 6543, for serverless on Vercel).
# Dashboard: https://supabase.com/dashboard/project/<ref>/settings/database
# Format: postgresql://postgres.<ref>:<password>@<host>:6543/postgres
# ──────────────────────────────────────────────────────────────
DATABASE_URL=

# ──────────────────────────────────────────────────────────────
# Embeddings — Voyage AI (Anthropic-aligned)
# Used only for the query-time embedding in lib/retrieval.js and by the
# `npm run seed:kb` script that regenerates data/embeddings.json. The
# catalog vectors are committed to the repo; we ship without a hosted
# vector DB and do cosine similarity in-memory.
# Get a key at: https://dash.voyageai.com/api-keys
# ──────────────────────────────────────────────────────────────
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# ──────────────────────────────────────────────────────────────
# External APIs (all optional for V1 chat; required for §8)
# ──────────────────────────────────────────────────────────────

# Google Cloud (enable Maps JS, Distance Matrix, Places API in console)
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# OpenWeatherMap — https://home.openweathermap.org/api_keys
OPENWEATHERMAP_API_KEY=

# Luma — no key needed. We scrape the public lu.ma/lisbon discovery page
# (Luma's official API is host-only and requires Luma Plus).


# SearchApi.io — TripAdvisor + Google data via a single direct API
# (not via RapidAPI). Powers the searchTripadvisor / getTripadvisorRating
# tools. Sign up at https://www.searchapi.io/ and copy the key from your
# dashboard. Free tier: 100 successful requests. Tool soft-fails if unset.
SEARCHAPI_KEY=

# ──────────────────────────────────────────────────────────────
# Voice — ElevenLabs (TTS + STT)
# Get a key at: https://elevenlabs.io/app/settings/api-keys
# Scopes: Text to Speech (access), Speech to Text (access), Voices (read).
# Voice id below = Victoria. Model = Flash v2.5 (low-latency conversational).
# STT model = Scribe v2.
# ──────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=qSeXEcewz7tA0Q0qk9fH
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STT_MODEL_ID=scribe_v2

# ──────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random 32+ char string for signing session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
